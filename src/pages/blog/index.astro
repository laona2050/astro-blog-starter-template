---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const POSTS_PER_PAGE = 30;
const totalPosts = allPosts.length;
const totalPages = Math.ceil(totalPosts / POSTS_PER_PAGE);

// 统计各分类文章数量
const categoryCount = {
	'航海': allPosts.filter(p => p.data.category === '航海').length,
	'国际时政': allPosts.filter(p => p.data.category === '国际时政').length,
	'生活思考': allPosts.filter(p => p.data.category === '生活思考').length,
};
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`文章列表 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet" />
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
	</head>
	<body>
		<Header />
		
		<main>
			<!-- Page Header -->
			<section class="page-header">
				<div class="header-content">
					<div class="breadcrumb">
						<a href="/"><i class="fas fa-home"></i></a>
						<span class="separator">/</span>
						<span>文章列表</span>
					</div>
					<h1>文章列表</h1>
					<p class="subtitle">共收录 {totalPosts} 篇文章</p>
				</div>
			</section>
			
			<!-- Category Filter -->
			<section class="category-filter">
				<div class="filter-container">
					<button class="filter-btn active" data-category="all">
						<i class="fas fa-th-large"></i>
						<span>全部</span>
						<span class="count">{totalPosts}</span>
					</button>
					<button class="filter-btn" data-category="航海">
						<i class="fas fa-anchor"></i>
						<span>航海</span>
						<span class="count">{categoryCount['航海']}</span>
					</button>
					<button class="filter-btn" data-category="国际时政">
						<i class="fas fa-globe"></i>
						<span>国际时政</span>
						<span class="count">{categoryCount['国际时政']}</span>
					</button>
					<button class="filter-btn" data-category="生活思考">
						<i class="fas fa-heart"></i>
						<span>生活思考</span>
						<span class="count">{categoryCount['生活思考']}</span>
					</button>
				</div>
			</section>
			
			<!-- Posts Grid -->
			<section class="posts-section">
				<div class="posts-grid" id="postsGrid">
					{
						allPosts.map((post) => (
							<article class="post-card" data-category={post.data.category || '航海'}>
								<a href={`/blog/${post.id}/`} class="post-card-link">
									<div class="post-card-body">
										<div class="post-card-category">
											<i class={`fas ${post.data.category === '航海' ? 'fa-anchor' : post.data.category === '国际时政' ? 'fa-globe' : 'fa-heart'}`}></i>
											<span>{post.data.category || '航海'}</span>
										</div>
										<h2 class="post-card-title">{post.data.title}</h2>
										<p class="post-card-desc">
											{post.data.description || '点击查看详情...'}
										</p>
									</div>
									<div class="post-card-footer">
										<span class="post-card-date">
											<i class="far fa-calendar-alt"></i>
											<FormattedDate date={post.data.pubDate} />
										</span>
										<span class="post-card-arrow">
											<i class="fas fa-arrow-right"></i>
										</span>
									</div>
								</a>
							</article>
						))
					}
				</div>
				
				<!-- Pagination -->
				<div class="pagination" id="pagination"></div>
				
				<!-- Page info -->
				<div class="page-info" id="pageInfo"></div>
			</section>
		</main>
		
		<Footer />
		
		<script>
			const POSTS_PER_PAGE = 30;
			let currentPage = 1;
			let currentCategory = 'all';
			
			const postsGrid = document.getElementById('postsGrid');
			const pagination = document.getElementById('pagination');
			const pageInfo = document.getElementById('pageInfo');
			const filterBtns = document.querySelectorAll('.filter-btn');
			const postCards = document.querySelectorAll('.post-card');
			
			function getFilteredPosts() {
				return currentCategory === 'all' 
					? [...postCards] 
					: postCards.filter(c => c.getAttribute('data-category') === currentCategory);
			}
			
			function renderPage(page) {
				const filtered = getFilteredPosts();
				const totalPages = Math.ceil(filtered.length / POSTS_PER_PAGE);
				
				// Show/hide cards based on page
				const start = (page - 1) * POSTS_PER_PAGE;
				const end = start + POSTS_PER_PAGE;
				
				// Reset display for filtered posts
				postCards.forEach(card => {
					const category = card.getAttribute('data-category');
					const isMatch = currentCategory === 'all' || category === currentCategory;
					if (!isMatch) {
						card.style.display = 'none';
						return;
					}
					
					// Check if within page range
					const filteredIdx = filtered.indexOf(card);
					if (filteredIdx >= start && filteredIdx < end) {
						card.style.display = 'block';
					} else {
						card.style.display = 'none';
					}
				});
				
				// Render pagination
				renderPagination(totalPages, page, filtered.length);
				
				// Page info
				const showStart = Math.min(start + 1, filtered.length);
				const showEnd = Math.min(end, filtered.length);
				if (filtered.length > POSTS_PER_PAGE) {
					pageInfo.textContent = `第 ${page} 页，显示 ${showStart}-${showEnd} / 共 ${filtered.length} 篇`;
					pageInfo.style.display = 'block';
				} else {
					pageInfo.style.display = 'none';
				}
				
				// Scroll to top of posts
				postsGrid.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}
			
			function renderPagination(totalPages, currentPage, totalItems) {
				if (totalPages <= 1) {
					pagination.innerHTML = '';
					pagination.style.display = 'none';
					return;
				}
				
				pagination.style.display = 'flex';
				let html = '';
				
				// Previous button
				if (currentPage > 1) {
					html += `<button class="page-btn" data-page="${currentPage - 1}"><i class="fas fa-chevron-left"></i></button>`;
				} else {
					html += `<button class="page-btn disabled" disabled><i class="fas fa-chevron-left"></i></button>`;
				}
				
				// Page numbers
				const maxVisible = 7;
				let startPage = Math.max(1, currentPage - Math.floor(maxVisible / 2));
				let endPage = Math.min(totalPages, startPage + maxVisible - 1);
				
				if (endPage - startPage + 1 < maxVisible) {
					startPage = Math.max(1, endPage - maxVisible + 1);
				}
				
				if (startPage > 1) {
					html += `<button class="page-btn" data-page="1">1</button>`;
					if (startPage > 2) {
						html += `<span class="page-ellipsis">...</span>`;
					}
				}
				
				for (let i = startPage; i <= endPage; i++) {
					if (i === currentPage) {
						html += `<button class="page-btn active">${i}</button>`;
					} else {
						html += `<button class="page-btn" data-page="${i}">${i}</button>`;
					}
				}
				
				if (endPage < totalPages) {
					if (endPage < totalPages - 1) {
						html += `<span class="page-ellipsis">...</span>`;
					}
					html += `<button class="page-btn" data-page="${totalPages}">${totalPages}</button>`;
				}
				
				// Next button
				if (currentPage < totalPages) {
					html += `<button class="page-btn" data-page="${currentPage + 1}"><i class="fas fa-chevron-right"></i></button>`;
				} else {
					html += `<button class="page-btn disabled" disabled><i class="fas fa-chevron-right"></i></button>`;
				}
				
				pagination.innerHTML = html;
				
				// Bind click events
				pagination.querySelectorAll('.page-btn:not(.disabled)').forEach(btn => {
					btn.addEventListener('click', () => {
						const page = parseInt(btn.getAttribute('data-page'));
						currentPage = page;
						renderPage(page);
					});
				});
			}
			
			// Category filter
			filterBtns.forEach(btn => {
				btn.addEventListener('click', () => {
					filterBtns.forEach(b => b.classList.remove('active'));
					btn.classList.add('active');
					
					currentCategory = btn.getAttribute('data-category');
					currentPage = 1;
					renderPage(1);
				});
			});
			
			// Initial render
			renderPage(1);
		</script>
	</body>
</html>

<style>
	.page-header {
		padding: 3rem 0 2rem;
		background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
		margin: 0 -1.5rem 2rem;
		padding-left: 1.5rem;
		padding-right: 1.5rem;
	}
	
	@media (max-width: 768px) {
		.page-header {
			margin: 0 -1rem 2rem;
			padding-left: 1rem;
			padding-right: 1rem;
		}
	}
	
	.header-content {
		max-width: 1200px;
		margin: 0 auto;
	}
	
	.breadcrumb {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1rem;
		font-size: 0.875rem;
	}
	
	.breadcrumb a {
		color: rgba(255, 255, 255, 0.8);
		text-decoration: none;
		transition: color 0.2s;
	}
	
	.breadcrumb a:hover {
		color: white;
	}
	
	.breadcrumb .separator {
		color: rgba(255, 255, 255, 0.5);
	}
	
	.breadcrumb span:last-child {
		color: white;
		font-weight: 500;
	}
	
	.page-header h1 {
		color: white;
		font-size: 2.5rem;
		margin: 0 0 0.5rem 0;
		font-family: 'Noto Sans SC', sans-serif;
	}
	
	.subtitle {
		color: rgba(255, 255, 255, 0.8);
		margin: 0;
		font-size: 1rem;
	}
	
	/* Category Filter */
	.category-filter {
		padding: 0 0 2rem;
	}
	
	.filter-container {
		max-width: 1200px;
		margin: 0 auto;
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
		justify-content: center;
	}
	
	.filter-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem 1.5rem;
		background: var(--white);
		border: 2px solid rgb(var(--gray-light));
		border-radius: 50px;
		color: rgb(var(--gray));
		font-size: 0.9rem;
		font-weight: 500;
		cursor: pointer;
		transition: all 0.2s ease;
	}
	
	.filter-btn:hover {
		border-color: var(--primary);
		color: var(--primary);
		transform: translateY(-2px);
		box-shadow: var(--shadow-md);
	}
	
	.filter-btn.active {
		background: var(--primary);
		border-color: var(--primary);
		color: var(--white);
	}
	
	.filter-btn i {
		font-size: 1rem;
	}
	
	.filter-btn .count {
		background: rgba(0, 0, 0, 0.1);
		padding: 0.125rem 0.5rem;
		border-radius: 12px;
		font-size: 0.75rem;
	}
	
	.filter-btn.active .count {
		background: rgba(255, 255, 255, 0.2);
	}
	
	@media (max-width: 640px) {
		.filter-container {
			gap: 0.5rem;
		}
		
		.filter-btn {
			padding: 0.5rem 1rem;
			font-size: 0.8rem;
		}
		
		.filter-btn span:not(.count) {
			display: none;
		}
	}
	
	/* Posts Grid */
	.posts-section {
		padding: 1rem 0 3rem;
	}
	
	.posts-grid {
		max-width: 1200px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}
	
	@media (max-width: 1024px) {
		.posts-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	
	@media (max-width: 640px) {
		.posts-grid {
			grid-template-columns: 1fr;
			gap: 1rem;
		}
	}
	
	/* Post Card */
	.post-card {
		opacity: 0;
		animation: fadeInUp 0.4s ease forwards;
		animation-delay: var(--delay, 0s);
	}
	
	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
	
	.post-card-link {
		display: flex;
		flex-direction: column;
		height: 100%;
		background: var(--white);
		border-radius: 12px;
		box-shadow: var(--shadow-sm);
		padding: 1.5rem;
		text-decoration: none;
		color: inherit;
		transition: all 0.25s ease;
		border: 1px solid transparent;
	}
	
	.post-card-link:hover {
		box-shadow: var(--shadow-lg);
		transform: translateY(-4px);
		border-color: var(--primary);
	}
	
	.post-card-body {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	
	.post-card-category {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		padding: 0.25rem 0.75rem;
		background: var(--wave-blue);
		color: var(--primary);
		border-radius: 20px;
		font-size: 0.75rem;
		font-weight: 500;
		width: fit-content;
	}
	
	.post-card-category i {
		font-size: 0.7rem;
		color: var(--accent);
	}
	
	.post-card-title {
		font-size: 1rem;
		font-weight: 600;
		color: var(--primary);
		margin: 0;
		line-height: 1.5;
		transition: color 0.2s;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	
	.post-card-link:hover .post-card-title {
		color: var(--primary-light);
	}
	
	.post-card-desc {
		font-size: 0.85rem;
		color: rgb(var(--gray));
		margin: 0;
		line-height: 1.6;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	
	.post-card-footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-top: 1rem;
		margin-top: 1rem;
		border-top: 1px solid rgb(var(--gray-light));
	}
	
	.post-card-date {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.78rem;
		color: rgb(var(--gray));
	}
	
	.post-card-date i {
		color: var(--accent);
	}
	
	.post-card-arrow {
		color: var(--primary);
		font-size: 0.85rem;
		opacity: 0;
		transition: opacity 0.2s, transform 0.2s;
		transform: translateX(-5px);
	}
	
	.post-card-link:hover .post-card-arrow {
		opacity: 1;
		transform: translateX(0);
	}
	
	/* Pagination */
	.pagination {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 0.5rem;
		padding: 2.5rem 0 1rem;
		flex-wrap: wrap;
	}
	
	.page-btn {
		min-width: 40px;
		height: 40px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0 0.75rem;
		background: var(--white);
		border: 2px solid rgb(var(--gray-light));
		border-radius: 8px;
		color: rgb(var(--gray));
		font-size: 0.9rem;
		font-weight: 500;
		cursor: pointer;
		transition: all 0.2s ease;
	}
	
	.page-btn:hover:not(.disabled) {
		border-color: var(--primary);
		color: var(--primary);
		transform: translateY(-2px);
		box-shadow: var(--shadow-sm);
	}
	
	.page-btn.active {
		background: var(--primary);
		border-color: var(--primary);
		color: var(--white);
	}
	
	.page-btn.disabled {
		opacity: 0.4;
		cursor: not-allowed;
	}
	
	.page-ellipsis {
		color: rgb(var(--gray));
		padding: 0 0.25rem;
	}
	
	/* Page Info */
	.page-info {
		text-align: center;
		padding: 0.5rem 0 2rem;
		font-size: 0.85rem;
		color: rgb(var(--gray));
	}
	
	@media (max-width: 640px) {
		.page-header h1 {
			font-size: 1.875rem;
		}
		
		.post-card-link {
			padding: 1.25rem;
		}
		
		.post-card-title {
			font-size: 0.95rem;
		}
		
		.post-card-desc {
			-webkit-line-clamp: 2;
		}
		
		.page-btn {
			min-width: 36px;
			height: 36px;
			font-size: 0.85rem;
		}
	}
</style>
