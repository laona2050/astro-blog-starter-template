---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const totalPosts = allPosts.length;

// 统计各分类文章数量
const categoryCount = {
	'航海': allPosts.filter(p => p.data.category === '航海').length,
	'国际时政': allPosts.filter(p => p.data.category === '国际时政').length,
	'生活思考': allPosts.filter(p => p.data.category === '生活思考').length,
};

// 只传必要字段给客户端，避免数据过大
const postsMeta = allPosts.map(p => ({
	id: p.id,
	title: p.data.title,
	desc: p.data.description || '',
	date: p.data.pubDate.toISOString(),
	cat: p.data.category || '航海',
}));
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`文章列表 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet" />
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
	</head>
	<body>
		<Header />
		
		<main>
			<!-- Page Header -->
			<section class="page-header">
				<div class="header-background"></div>
				<div class="header-content">
					<div class="breadcrumb">
						<a href="/"><i class="fas fa-home"></i></a>
						<span class="separator">/</span>
						<span>文章列表</span>
					</div>
					<div class="section-tag">
						<i class="fas fa-compass"></i>
						<span>探索所有文章</span>
					</div>
					<h1>文章列表</h1>
					<p class="subtitle">共收录 {totalPosts} 篇文章</p>
				</div>
			</section>
			
			<!-- Category Filter -->
			<section class="category-filter">
				<div class="filter-container">
					<button class="filter-btn active" data-category="all">
						<i class="fas fa-th-large"></i>
						<span>全部</span>
						<span class="count">{totalPosts}</span>
					</button>
					<button class="filter-btn" data-category="航海">
						<i class="fas fa-anchor"></i>
						<span>航海</span>
						<span class="count">{categoryCount['航海']}</span>
					</button>
					<button class="filter-btn" data-category="国际时政">
						<i class="fas fa-globe"></i>
						<span>国际时政</span>
						<span class="count">{categoryCount['国际时政']}</span>
					</button>
					<button class="filter-btn" data-category="生活思考">
						<i class="fas fa-heart"></i>
						<span>生活思考</span>
						<span class="count">{categoryCount['生活思考']}</span>
					</button>
				</div>
			</section>
			
			<!-- Posts Grid -->
			<section class="posts-section">
				<div class="posts-grid" id="postsGrid"></div>
				<nav class="pagination" id="pagination"></nav>
				<div class="page-info" id="pageInfo"></div>
			</section>
		</main>
		
		<Footer />
		
		<script define:vars={{ posts: postsMeta }}>
			const PER_PAGE = 9;
			let page = 1, cat = 'all';
			const grid = document.getElementById('postsGrid');
			const pag = document.getElementById('pagination');
			const info = document.getElementById('pageInfo');
			const btns = document.querySelectorAll('.filter-btn');
			
			function icon(c) { return c==='航海'?'fa-anchor':c==='国际时政'?'fa-globe':'fa-heart'; }
			function fmt(d) { const x=new Date(d); return `${x.getFullYear()}-${String(x.getMonth()+1).padStart(2,'0')}-${String(x.getDate()).padStart(2,'0')}`; }
			
			function filtered() { return cat==='all' ? posts : posts.filter(p=>p.cat===cat); }
			
			function render() {
				const f = filtered();
			 const tp = Math.max(1, Math.ceil(f.length/PER_PAGE));
			 if(page>tp) page=tp;
			 const s=(page-1)*PER_PAGE, e=Math.min(s+PER_PAGE,f.length);
			 
			 grid.innerHTML = f.slice(s,e).map((p,i)=>{
				 const ex = p.desc.slice(0,80)+(p.desc.length>80?'...':'');
				 return `<article class="post-card" style="--delay:${i*0.05}s">
					<a href="/blog/${p.id}/" class="post-link"><div class="post-content">
					 <div class="post-meta">
					  <span class="post-date"><i class="far fa-calendar"></i>${fmt(p.date)}</span>
					  <span class="post-category-tag"><i class="fas ${icon(p.cat)}"></i><span>${p.cat}</span></span>
					 </div>
					 <h3 class="post-title">${p.title}</h3>
					 <p class="post-excerpt">${ex}</p>
					 <div class="post-footer"><span class="read-more">阅读全文 <i class="fas fa-arrow-right"></i></span></div>
					</div></a></article>`;
			 }).join('');
			 
			 info.textContent = f.length>PER_PAGE ? `第 ${page} 页，显示 ${s+1}-${e} / 共 ${f.length} 篇` : '';
			 info.style.display = f.length>PER_PAGE?'block':'none';
			 
			 if(tp<=1){pag.innerHTML='';pag.style.display='none';return;}
			 pag.style.display='flex';
			 let h='';
			 h += page>1?`<button class="page-btn" data-p="${page-1}"><i class="fas fa-chevron-left"></i></button>`:`<button class="page-btn disabled" disabled><i class="fas fa-chevron-left"></i></button>`;
			 const mx=7; let ss=Math.max(1,page-Math.floor(mx/2)), ee=Math.min(tp,ss+mx-1);
			 if(ee-ss+1<mx) ss=Math.max(1,ee-mx+1);
			 if(ss>1){h+=`<button class="page-btn" data-p="1">1</button>`;if(ss>2)h+='<span class="page-ellipsis">...</span>';}
			 for(let i=ss;i<=ee;i++) h+=i===page?`<button class="page-btn active">${i}</button>`:`<button class="page-btn" data-p="${i}">${i}</button>`;
			 if(ee<tp){if(ee<tp-1)h+='<span class="page-ellipsis">...</span>';h+=`<button class="page-btn" data-p="${tp}">${tp}</button>`;}
			 h += page<tp?`<button class="page-btn" data-p="${page+1}"><i class="fas fa-chevron-right"></i></button>`:`<button class="page-btn disabled" disabled><i class="fas fa-chevron-right"></i></button>`;
			 pag.innerHTML=h;
			 pag.querySelectorAll('.page-btn:not(.disabled)').forEach(b=>b.addEventListener('click',()=>{page=+b.getAttribute('data-p');render();}));
			}
			
			btns.forEach(b=>b.addEventListener('click',()=>{
				btns.forEach(x=>x.classList.remove('active'));b.classList.add('active');
				cat=b.getAttribute('data-category');page=1;render();
			}));
			
			render();
		</script>
	</body>
</html>

<style>
	.page-header {
		position: relative;
		padding: 5rem 0 3rem;
		margin: 0 -1.5rem 1rem;
		padding-left: 1.5rem;
		padding-right: 1.5rem;
		overflow: hidden;
	}
	.page-header::before {
		content: '';
		position: absolute;
		top: 0; left: 0; right: 0; bottom: 0;
		background: url('/images/blog-banner/banner-bg.jpg') center/cover no-repeat;
		filter: blur(3px) brightness(0.85);
		opacity: 0.6;
		z-index: 0;
	}
	.header-background {
		position: absolute;
		top: 0; left: 0; right: 0; bottom: 0;
		background: linear-gradient(135deg, rgba(147, 197, 253, 0.50) 0%, rgba(219, 234, 254, 0.45) 50%, rgba(239, 246, 255, 0.40) 100%);
		z-index: 0;
	}
	@media (max-width: 768px) {
		.page-header { margin: 0 -1rem 1rem; padding-left: 1rem; padding-right: 1rem; }
	}
	.header-content {
		max-width: 800px;
		margin: 0 auto;
		position: relative;
		z-index: 1;
		text-align: center;
	}
	.breadcrumb {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1.5rem;
		font-size: 0.875rem;
		padding: 0.5rem 1rem;
		background: linear-gradient(135deg, rgba(255, 255, 255, 0.25) 0%, rgba(255, 255, 255, 0.35) 100%);
		border-radius: 50px;
		border: 1px solid rgba(255, 255, 255, 0.5);
		backdrop-filter: blur(10px);
	}
	.breadcrumb a { color: rgba(255,255,255,0.8); text-decoration: none; transition: color 0.2s; }
	.breadcrumb a:hover { color: white; }
	.breadcrumb .separator { color: rgba(255,255,255,0.5); }
	.breadcrumb span:last-child { color: white; font-weight: 500; }
	.section-tag {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 1rem;
		background: linear-gradient(135deg, rgba(245, 158, 11, 0.1) 0%, rgba(245, 158, 11, 0.2) 100%);
		color: var(--accent-light);
		border-radius: 50px;
		font-size: 0.875rem;
		font-weight: 500;
		margin-bottom: 1rem;
		border: 1px solid rgba(245, 158, 11, 0.3);
	}
	.section-tag i { color: var(--accent); }
	.page-header h1 {
		color: var(--white);
		font-size: 2.5rem;
		margin: 0 0 0.5rem 0;
		font-family: 'Noto Sans SC', sans-serif;
		text-shadow: 0 3px 12px rgba(0, 0, 0, 0.4), 0 2px 6px rgba(0, 0, 0, 0.3);
	}
	@media (max-width: 768px) {
		.page-header h1 { font-size: 2rem; }
	}
	.subtitle {
		color: rgba(255, 255, 255, 1);
		margin: 0;
		font-size: 1rem;
		text-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
	}
	.category-filter { padding: 0 0 2rem; }
	.filter-container { max-width: 1200px; margin: 0 auto; display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; }
	.filter-btn {
		display: inline-flex; align-items: center; gap: 0.5rem;
		padding: 0.75rem 1.5rem; background: var(--white); border: 2px solid rgb(var(--gray-light));
		border-radius: 50px; color: rgb(var(--gray)); font-size: 0.9rem; font-weight: 500; cursor: pointer; transition: all 0.2s ease;
	}
	.filter-btn:hover { border-color: var(--accent); color: var(--accent); transform: translateY(-2px); box-shadow: var(--shadow-md); }
	.filter-btn.active { background: linear-gradient(135deg, var(--accent) 0%, var(--accent-light) 100%); border-color: var(--accent); color: var(--white); }
	.filter-btn i { font-size: 1rem; }
	.filter-btn .count { background: rgba(0,0,0,0.1); padding: 0.125rem 0.5rem; border-radius: 12px; font-size: 0.75rem; }
	.filter-btn.active .count { background: rgba(255,255,255,0.2); }
	@media (max-width: 640px) {
		.filter-container { gap: 0.5rem; }
		.filter-btn { padding: 0.5rem 1rem; font-size: 0.8rem; }
		.filter-btn span:not(.count) { display: none; }
	}
	.posts-section { padding: 1rem 0 4rem; }
	.posts-grid { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
	@media (max-width: 1024px) { .posts-grid { grid-template-columns: repeat(2, 1fr); } }
	@media (max-width: 640px) { .posts-grid { grid-template-columns: 1fr; } }
	.post-card {
		background: linear-gradient(135deg, var(--wave-gray) 0%, var(--primary-light) 100%);
		border-radius: 16px; box-shadow: var(--shadow-md); overflow: hidden;
		transition: all 0.3s ease; opacity: 0; animation: fadeInUp 0.6s ease forwards; animation-delay: var(--delay, 0s);
		border: 1px solid rgba(245, 158, 11, 0.1);
	}
	@keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
	.post-card:hover { box-shadow: var(--shadow-xl), 0 0 30px rgba(245, 158, 11, 0.2); transform: translateY(-4px); border-color: rgba(245, 158, 11, 0.3); }
	.post-link { display: block; text-decoration: none; color: inherit; padding: 1.5rem; height: 100%; }
	.post-content { display: flex; flex-direction: column; height: 100%; }
	.post-meta { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem; flex-wrap: wrap; }
	.post-date { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; color: rgb(var(--gray)); }
	.post-date i { color: var(--accent); }
	.post-category-tag { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.2rem 0.65rem; background: rgba(245,158,11,0.1); color: var(--accent-light); border-radius: 20px; font-size: 0.7rem; font-weight: 500; border: 1px solid rgba(245,158,11,0.2); }
	.post-category-tag i { font-size: 0.65rem; color: var(--accent); }
	.post-title { font-size: 1.125rem; font-weight: 600; color: var(--accent-light); margin: 0 0 0.75rem 0; line-height: 1.4; transition: all 0.2s; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
	.post-card:hover .post-title { color: var(--accent); text-shadow: 0 0 10px rgba(245, 158, 11, 0.5); }
	.post-excerpt { font-size: 0.9rem; color: rgb(var(--gray)); margin: 0 0 1rem 0; line-height: 1.6; flex-grow: 1; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
	.post-footer { margin-top: auto; }
	.read-more { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; font-weight: 500; color: var(--accent-light); transition: all 0.2s; }
	.post-card:hover .read-more { gap: 0.75rem; color: var(--accent); text-shadow: 0 0 10px rgba(245, 158, 11, 0.5); }
	.pagination { display: flex; justify-content: center; align-items: center; gap: 0.5rem; padding: 2.5rem 0 1rem; flex-wrap: wrap; }
	.page-btn { min-width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center; padding: 0 0.75rem; background: var(--white); border: 2px solid rgb(var(--gray-light)); border-radius: 8px; color: rgb(var(--gray)); font-size: 0.9rem; font-weight: 500; cursor: pointer; transition: all 0.2s ease; }
	.page-btn:hover:not(.disabled) { border-color: var(--accent); color: var(--accent); transform: translateY(-2px); box-shadow: var(--shadow-sm); }
	.page-btn.active { background: linear-gradient(135deg, var(--accent) 0%, var(--accent-light) 100%); border-color: var(--accent); color: var(--white); }
	.page-btn.disabled { opacity: 0.4; cursor: not-allowed; }
	.page-ellipsis { color: rgb(var(--gray)); padding: 0 0.25rem; }
	.page-info { text-align: center; padding: 0.5rem 0 2rem; font-size: 0.85rem; color: rgb(var(--gray)); }
	@media (max-width: 640px) {
		.page-header h1 { font-size: 1.875rem; }
		.post-link { padding: 1.25rem; }
		.post-title { font-size: 1rem; }
		.page-btn { min-width: 36px; height: 36px; font-size: 0.85rem; }
	}
</style>
