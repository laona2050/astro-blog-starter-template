---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const totalPosts = allPosts.length;

// 分页设置：每页 20 篇
const POSTS_PER_PAGE = 20;
const totalPages = Math.ceil(totalPosts / POSTS_PER_PAGE);

// 获取当前页码
const currentPage = Astro.url ? parseInt(Astro.url.searchParams.get('page') || '1') : 1;
const startIndex = (currentPage - 1) * POSTS_PER_PAGE;
const endIndex = startIndex + POSTS_PER_PAGE;
const posts = allPosts.slice(startIndex, endIndex);

// 统计各分类文章数量
const categoryCount = {
	'航海': allPosts.filter(p => p.data.category === '航海').length,
	'经济海': allPosts.filter(p => p.data.category === '经济海').length,
	'科技海': allPosts.filter(p => p.data.category === '科技海').length,
	'生活海': allPosts.filter(p => p.data.category === '生活海').length,
};
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`文章列表 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet" />
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
	</head>
	<body>
		<Header />
		
		<main>
			<!-- Page Header -->
			<section class="page-header">
				<div class="header-content">
					<div class="breadcrumb">
						<a href="/"><i class="fas fa-home"></i></a>
						<span class="separator">/</span>
						<span>文章列表</span>
					</div>
					<h1>文章列表</h1>
					<p class="subtitle">共收录 {totalPosts} 篇文章</p>
				</div>
			</section>
			
			<!-- Category Filter -->
			<section class="category-filter">
				<div class="filter-container">
					<button class="filter-btn active" data-category="all">
						<i class="fas fa-th-large"></i>
						<span>全部</span>
						<span class="count">{totalPosts}</span>
					</button>
					<button class="filter-btn" data-category="航海">
						<i class="fas fa-anchor"></i>
						<span>航海</span>
						<span class="count">{categoryCount['航海']}</span>
					</button>
					<button class="filter-btn" data-category="国际时政">
						<i class="fas fa-globe"></i>
						<span>国际时政</span>
						<span class="count">{categoryCount['国际时政']}</span>
					</button>
					<button class="filter-btn" data-category="生活思考">
						<i class="fas fa-heart"></i>
						<span>生活思考</span>
						<span class="count">{categoryCount['生活思考']}</span>
					</button>
				</div>
			</section>
			
			<!-- Posts List -->
			<section class="posts-section">
				<div class="posts-container">
					{
						posts.map((post, index) => (
							<article class="post-item" style={`--delay: ${index * 0.05}s`} data-category={post.data.category || '航海'}>
								<div class="post-marker">
									<div class="marker-dot"></div>
									<div class="marker-line"></div>
								</div>
								<a href={`/blog/${post.id}/`} class="post-content">
									<div class="post-main">
										<div class="post-category-badge">
											<i class={`fas ${post.data.category === '航海' ? 'fa-anchor' : post.data.category === '经济海' ? 'fa-coins' : post.data.category === '科技海' ? 'fa-microchip' : 'fa-heart'}`}></i>
											<span>{post.data.category || '航海'}</span>
										</div>
										<h2 class="post-title">{post.data.title}</h2>
										<p class="post-description">
											{post.data.description || '点击查看详情...'}
										</p>
									</div>
									<div class="post-meta">
										<span class="meta-item">
											<i class="far fa-calendar-alt"></i>
											<FormattedDate date={post.data.pubDate} />
										</span>
										<span class="meta-item read-hint">
											阅读全文 <i class="fas fa-chevron-right"></i>
										</span>
									</div>
								</a>
							</article>
						))
					}
				</div>
				
				<!-- 分页导航 -->
				{totalPages > 1 && (
					<div class="pagination">
						{currentPage > 1 && (
							<a href={currentPage === 2 ? '/blog/' : `/blog/?page=${currentPage - 1}`} class="page-btn prev">
								<i class="fas fa-chevron-left"></i> 上一页
							</a>
						)}
						
						<div class="page-numbers">
							{Array.from({ length: totalPages }, (_, i) => i + 1).map(page => (
								<a 
									href={page === 1 ? '/blog/' : `/blog/?page=${page}`}
									class={`page-number ${page === currentPage ? 'active' : ''}`}
								>
									{page}
								</a>
							))}
						</div>
						
						{currentPage < totalPages && (
							<a href={`/blog/?page=${currentPage + 1}`} class="page-btn next">
								下一页 <i class="fas fa-chevron-right"></i>
							</a>
						)}
					</div>
				)}
				
				{totalPages <= 1 && (
					<div class="posts-end">
						<div class="end-icon"><i class="fas fa-anchor"></i></div>
						<p>已展示全部 {totalPosts} 篇文章</p>
					</div>
				)}
			</section>
		</main>
		
		<Footer />
		
		<script>
			// 分类筛选功能
			const filterBtns = document.querySelectorAll('.filter-btn');
			const postItems = document.querySelectorAll('.post-item');
			
			filterBtns.forEach(btn => {
				btn.addEventListener('click', () => {
					// 移除所有按钮的 active 类
					filterBtns.forEach(b => b.classList.remove('active'));
					// 添加当前按钮的 active 类
					btn.classList.add('active');
					
					const category = btn.getAttribute('data-category');
					
					// 筛选文章
					postItems.forEach(item => {
						const itemCategory = item.getAttribute('data-category');
						if (category === 'all' || itemCategory === category) {
							item.style.display = 'flex';
						} else {
							item.style.display = 'none';
						}
					});
				});
			});
		</script>
	</body>
</html>

<style>
	.page-header {
		padding: 3rem 0 2rem;
		background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
		margin: 0 -1.5rem 2rem;
		padding-left: 1.5rem;
		padding-right: 1.5rem;
	}
	
	@media (max-width: 768px) {
		.page-header {
			margin: 0 -1rem 2rem;
			padding-left: 1rem;
			padding-right: 1rem;
		}
	}
	
	.header-content {
		max-width: 1200px;
		margin: 0 auto;
	}
	
	.breadcrumb {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1rem;
		font-size: 0.875rem;
	}
	
	.breadcrumb a {
		color: rgba(255, 255, 255, 0.8);
		text-decoration: none;
		transition: color 0.2s;
	}
	
	.breadcrumb a:hover {
		color: white;
	}
	
	.breadcrumb .separator {
		color: rgba(255, 255, 255, 0.5);
	}
	
	.breadcrumb span:last-child {
		color: white;
		font-weight: 500;
	}
	
	.page-header h1 {
		color: white;
		font-size: 2.5rem;
		margin: 0 0 0.5rem 0;
		font-family: 'Noto Sans SC', sans-serif;
	}
	
	.subtitle {
		color: rgba(255, 255, 255, 0.8);
		margin: 0;
		font-size: 1rem;
	}
	
	/* Category Filter */
	.category-filter {
		padding: 0 0 2rem;
	}
	
	.filter-container {
		max-width: 1200px;
		margin: 0 auto;
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
		justify-content: center;
	}
	
	.filter-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem 1.5rem;
		background: var(--white);
		border: 2px solid rgb(var(--gray-light));
		border-radius: 50px;
		color: rgb(var(--gray));
		font-size: 0.9rem;
		font-weight: 500;
		cursor: pointer;
		transition: all 0.2s ease;
	}
	
	.filter-btn:hover {
		border-color: var(--primary);
		color: var(--primary);
		transform: translateY(-2px);
		box-shadow: var(--shadow-md);
	}
	
	.filter-btn.active {
		background: var(--primary);
		border-color: var(--primary);
		color: var(--white);
	}
	
	.filter-btn i {
		font-size: 1rem;
	}
	
	.filter-btn .count {
		background: rgba(0, 0, 0, 0.1);
		padding: 0.125rem 0.5rem;
		border-radius: 12px;
		font-size: 0.75rem;
	}
	
	.filter-btn.active .count {
		background: rgba(255, 255, 255, 0.2);
	}
	
	@media (max-width: 640px) {
		.filter-container {
			gap: 0.5rem;
		}
		
		.filter-btn {
			padding: 0.5rem 1rem;
			font-size: 0.8rem;
		}
		
		.filter-btn span:not(.count) {
			display: none;
		}
	}
	
	/* Posts Section */
	.posts-section {
		padding: 1rem 0 3rem;
	}
	
	.posts-container {
		max-width: 800px;
		margin: 0 auto;
	}
	
	.post-item {
		display: flex;
		gap: 1.5rem;
		margin-bottom: 0;
		opacity: 0;
		animation: slideIn 0.4s ease forwards;
		animation-delay: var(--delay, 0s);
	}
	
	@keyframes slideIn {
		from {
			opacity: 0;
			transform: translateX(-20px);
		}
		to {
			opacity: 1;
			transform: translateX(0);
		}
	}
	
	.post-marker {
		display: flex;
		flex-direction: column;
		align-items: center;
		flex-shrink: 0;
		padding-top: 0.5rem;
	}
	
	.marker-dot {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--accent);
		border: 3px solid var(--white);
		box-shadow: 0 0 0 2px var(--accent);
	}
	
	.marker-line {
		flex-grow: 1;
		width: 2px;
		background: linear-gradient(to bottom, var(--accent), transparent);
		min-height: 60px;
	}
	
	.post-item:last-child .marker-line {
		display: none;
	}
	
	.post-content {
		flex-grow: 1;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1.25rem;
		background: var(--white);
		border-radius: 12px;
		box-shadow: var(--shadow-sm);
		margin-bottom: 1.5rem;
		text-decoration: none;
		color: inherit;
		transition: all 0.2s ease;
	}
	
	.post-content:hover {
		box-shadow: var(--shadow-md);
		transform: translateX(4px);
	}
	
	.post-main {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	
	.post-category-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		padding: 0.25rem 0.75rem;
		background: var(--wave-blue);
		color: var(--primary);
		border-radius: 20px;
		font-size: 0.75rem;
		font-weight: 500;
		width: fit-content;
		margin-bottom: 0.25rem;
	}
	
	.post-category-badge i {
		font-size: 0.7rem;
		color: var(--accent);
	}
	
	.post-title {
		font-size: 1.125rem;
		font-weight: 600;
		color: var(--primary);
		margin: 0;
		line-height: 1.4;
		transition: color 0.2s;
	}
	
	.post-content:hover .post-title {
		color: var(--primary-light);
	}
	
	.post-description {
		font-size: 0.9rem;
		color: rgb(var(--gray));
		margin: 0;
		line-height: 1.6;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	
	.post-meta {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-top: 0.75rem;
		border-top: 1px solid rgb(var(--gray-light));
	}
	
	.meta-item {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.8rem;
		color: rgb(var(--gray));
	}
	
	.meta-item i {
		color: var(--accent);
	}
	
	.read-hint {
		color: var(--primary);
		font-weight: 500;
		opacity: 0;
		transition: opacity 0.2s;
	}
	
	.post-content:hover .read-hint {
		opacity: 1;
	}
	
	/* Posts End */
	.posts-end {
		text-align: center;
		padding: 3rem 0;
		color: rgb(var(--gray));
	}
	
	.end-icon {
		font-size: 2rem;
		color: var(--accent);
		margin-bottom: 0.5rem;
	}
	
	.posts-end p {
		margin: 0;
		font-size: 0.9rem;
	}
	
	@media (max-width: 640px) {
		.page-header h1 {
			font-size: 1.875rem;
		}
		
		.post-item {
			gap: 1rem;
		}
		
		.marker-line {
			min-height: 40px;
		}
		
		.read-hint {
			display: none;
		}
	}
	
	/* Pagination */
	.pagination {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 1rem;
		padding: 3rem 0;
	}
	
	.page-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem 1.5rem;
		background: var(--white);
		border: 2px solid rgb(var(--gray-light));
		border-radius: 50px;
		color: rgb(var(--gray));
		font-size: 0.9rem;
		font-weight: 500;
		text-decoration: none;
		transition: all 0.2s ease;
	}
	
	.page-btn:hover {
		border-color: var(--primary);
		color: var(--primary);
		transform: translateY(-2px);
		box-shadow: var(--shadow-md);
	}
	
	.page-btn i {
		font-size: 0.8rem;
	}
	
	.page-numbers {
		display: flex;
		gap: 0.5rem;
	}
	
	.page-number {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 2.5rem;
		height: 2.5rem;
		padding: 0 0.5rem;
		background: var(--white);
		border: 2px solid rgb(var(--gray-light));
		border-radius: 50%;
		color: rgb(var(--gray));
		font-size: 0.9rem;
		font-weight: 500;
		text-decoration: none;
		transition: all 0.2s ease;
	}
	
	.page-number:hover {
		border-color: var(--primary);
		color: var(--primary);
		transform: translateY(-2px);
	}
	
	.page-number.active {
		background: var(--primary);
		border-color: var(--primary);
		color: var(--white);
	}
	
	@media (max-width: 640px) {
		.pagination {
			flex-wrap: wrap;
			gap: 0.75rem;
		}
		
		.page-numbers {
			order: 3;
			width: 100%;
			justify-content: center;
			margin-top: 0.5rem;
		}
		
		.page-btn {
			padding: 0.5rem 1rem;
			font-size: 0.85rem;
		}
		
		.page-number {
			min-width: 2rem;
			height: 2rem;
			font-size: 0.85rem;
		}
	}
</style>
