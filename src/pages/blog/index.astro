---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const totalPosts = allPosts.length;
const PER_PAGE = 9;

// 分类定义（新增分类只需改这里）
const CATEGORIES = [
	{ name: '游艇评测', icon: 'fa-ship' },
	{ name: '航海生活', icon: 'fa-anchor' },
	{ name: '科技观察', icon: 'fa-microchip' },
];

const categoryCount = Object.fromEntries(
	CATEGORIES.map(c => [c.name, allPosts.filter(p => p.data.category === c.name).length]),
);
const CAT_ICON = Object.fromEntries(CATEGORIES.map(c => [c.name, c.icon]));

// Banner 轮播底图：图床直链 + 原图尺寸（显式宽高避免布局抖动）
const BANNER_IMAGES = [
	{ src: 'https://pic.homesh.top/file/AgACAgUAAyEGAATfDUfbAAMjavb4BnbXm6koutLmNGQq8EBVnigAAvgbaxt-BrhX--fUvdTj1TwBAAMCAAN3AAM9BA.jpg', width: 1920, height: 894 },
	{ src: 'https://pic.homesh.top/file/AgACAgUAAyEGAATfDUfbAAMkavb4BptVpFQNg00uGX1yS7_K8_QAAvkbaxt-BrhXSKR6llrMgBwBAAMCAAN3AAM9BA.jpg', width: 1920, height: 768 },
	{ src: 'https://pic.homesh.top/file/AgACAgUAAyEGAATfDUfbAAMlavb4BgojPGO-HW-LHM8DCCIzVucAAvobaxt-BrhXtJbLrUycTbcBAAMCAAN3AAM9BA.jpg', width: 1920, height: 792 },
	{ src: 'https://pic.homesh.top/file/AgACAgUAAyEGAATfDUfbAAMmavb4CB0ZnQLgh113iUM7BDzGXS8AAvsbaxt-BrhXzfyio1Vk3QABAQADAgADdwADPQQ.jpg', width: 1920, height: 700 },
	{ src: 'https://pic.homesh.top/file/AgACAgUAAyEGAATfDUfbAAMnavb4CEecocLRGjmmtv_zTBRGoO8AAvwbaxt-BrhXtGmBJLT8DKEBAAMCAAN3AAM9BA.jpg', width: 1920, height: 666 },
	{ src: 'https://pic.homesh.top/file/AgACAgUAAyEGAATfDUfbAAMoavb4DAOB1VrtsJUlvxjhC3lzMwAD_RtrG34GuFc5ZQsCpXfAIAEAAwIAA3cAAz0E.jpg', width: 1920, height: 700 },
	{ src: 'https://pic.homesh.top/file/AgACAgUAAyEGAATfDUfbAAMpavb4DCmz9RunUN7Rs3BVwcRyxRsAAv4baxt-BrhXAlckiZcqNjUBAAMCAAN3AAM9BA.jpg', width: 1664, height: 936 },
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`文章列表 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet" />
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
		<link rel="preconnect" href="https://pic.homesh.top" />
		<link rel="preload" as="image" href={BANNER_IMAGES[0].src} />
	</head>
	<body>
		<Header />

		<main>
			<!-- Page Header -->
			<section class="page-header">
				<!-- 轮播底图：装饰性内容，对屏幕阅读器隐藏 -->
				<div class="banner-carousel" aria-hidden="true">
					{BANNER_IMAGES.map((img, i) => (
						<img
							class:list={['banner-slide', { 'is-active': i === 0 }]}
							src={i === 0 ? img.src : undefined}
							data-src={i === 0 ? undefined : img.src}
							width={img.width}
							height={img.height}
							alt=""
							loading={i === 0 ? 'eager' : 'lazy'}
							decoding="async"
						/>
					))}
				</div>
				<div class="header-background"></div>
				<div class="header-content">
					<div class="breadcrumb">
						<a href="/"><i class="fas fa-home"></i></a>
						<span class="separator">/</span>
						<span>文章列表</span>
					</div>
					<div class="section-tag">
						<i class="fas fa-compass"></i>
						<span>探索所有文章</span>
					</div>
					<h1>文章列表</h1>
					<p class="subtitle">共收录 {totalPosts} 篇文章</p>
				</div>
			</section>

			<!-- Category Filter -->
			<section class="category-filter">
				<div class="filter-container">
					<button class="filter-btn active" data-category="all">
						<i class="fas fa-th-large"></i>
						<span>全部</span>
						<span class="count">{totalPosts}</span>
					</button>
					{CATEGORIES.map(c => (
						<button class="filter-btn" data-category={c.name}>
							<i class={`fas ${c.icon}`}></i>
							<span>{c.name}</span>
							<span class="count">{categoryCount[c.name]}</span>
						</button>
					))}
				</div>
			</section>

			<!-- Posts Grid：与首页一致，服务端渲染卡片，保证样式与 SEO 生效 -->
			<section class="posts-section">
				<div class="posts-grid" id="postsGrid">
					{allPosts.map((post, index) => (
						<article
							class="post-card"
							data-category={post.data.category || '游艇评测'}
							style={`--delay: ${(index % PER_PAGE) * 0.1}s`}
						>
							<a href={`/blog/${post.id}/`} class="post-link">
								<div class="post-content">
									<div class="post-meta">
										<span class="post-date">
											<i class="far fa-calendar"></i>
											<FormattedDate date={post.data.pubDate} />
										</span>
										<span class="post-category-tag">
											<i class={`fas ${CAT_ICON[post.data.category] || 'fa-file-alt'}`}></i>
											<span>{post.data.category || '游艇评测'}</span>
										</span>
									</div>
									<h3 class="post-title">{post.data.title}</h3>
									<p class="post-excerpt">
										{post.data.description?.slice(0, 80) || '点击阅读更多...'}
										{post.data.description?.length > 80 ? '...' : ''}
									</p>
									<div class="post-footer">
										<span class="read-more">阅读全文 <i class="fas fa-arrow-right"></i></span>
									</div>
								</div>
							</a>
						</article>
					))}
				</div>
				<nav class="pagination blog-pagination" id="pagination"></nav>
				<div class="page-info blog-page-info" id="pageInfo"></div>
			</section>
		</main>

		<Footer />

		<script define:vars={{ perPage: PER_PAGE }}>
			const cards = Array.from(document.querySelectorAll('#postsGrid .post-card'));
			const pag = document.getElementById('pagination');
			const info = document.getElementById('pageInfo');
			const btns = document.querySelectorAll('.filter-btn');
			let page = 1, cat = 'all';

			function render() {
				const f = cat === 'all' ? cards : cards.filter(c => c.getAttribute('data-category') === cat);
				const tp = Math.max(1, Math.ceil(f.length / perPage));
				if (page > tp) page = tp;
				const s = (page - 1) * perPage, e = Math.min(s + perPage, f.length);

				cards.forEach(c => { c.style.display = 'none'; });
				f.slice(s, e).forEach((c, i) => {
					c.style.display = '';
					c.style.setProperty('--delay', `${i * 0.1}s`);
				});

				info.textContent = f.length > perPage ? `第 ${page} 页，显示 ${s + 1}-${e} / 共 ${f.length} 篇` : '';
				info.style.display = f.length > perPage ? 'block' : 'none';

				if (tp <= 1) { pag.innerHTML = ''; pag.style.display = 'none'; return; }
				pag.style.display = 'flex';
				let h = '';
				h += page > 1 ? `<button class="page-btn" data-p="${page - 1}"><i class="fas fa-chevron-left"></i></button>` : `<button class="page-btn disabled" disabled><i class="fas fa-chevron-left"></i></button>`;
				const mx = 7; let ss = Math.max(1, page - Math.floor(mx / 2)), ee = Math.min(tp, ss + mx - 1);
				if (ee - ss + 1 < mx) ss = Math.max(1, ee - mx + 1);
				if (ss > 1) { h += `<button class="page-btn" data-p="1">1</button>`; if (ss > 2) h += '<span class="page-ellipsis">...</span>'; }
				for (let i = ss; i <= ee; i++) h += i === page ? `<button class="page-btn active">${i}</button>` : `<button class="page-btn" data-p="${i}">${i}</button>`;
				if (ee < tp) { if (ee < tp - 1) h += '<span class="page-ellipsis">...</span>'; h += `<button class="page-btn" data-p="${tp}">${tp}</button>`; }
				h += page < tp ? `<button class="page-btn" data-p="${page + 1}"><i class="fas fa-chevron-right"></i></button>` : `<button class="page-btn disabled" disabled><i class="fas fa-chevron-right"></i></button>`;
				pag.innerHTML = h;
				pag.querySelectorAll('.page-btn:not(.disabled)').forEach(b => b.addEventListener('click', () => { page = +b.getAttribute('data-p'); render(); }));
			}

			btns.forEach(b => b.addEventListener('click', () => {
				btns.forEach(x => x.classList.remove('active'));
				b.classList.add('active');
				cat = b.getAttribute('data-category');
				page = 1;
				render();
			}));

			render();
		</script>

		<script>
			// Banner 轮播：按需加载、hover 暂停、后台标签页暂停、尊重减少动效偏好
			(() => {
				const header = document.querySelector('.page-header');
				const carousel = document.querySelector('.banner-carousel');
				if (!header || !carousel) return;
				const slides = Array.from(carousel.querySelectorAll('.banner-slide'));
				if (slides.length < 2) return;

				const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
				const INTERVAL = 5000;
				let current = 0;
				let timerId = null;

				function load(i) {
					const img = slides[i];
					if (img && img.dataset.src) {
						img.src = img.dataset.src;
						delete img.dataset.src;
					}
				}
				function show(i) {
					current = (i + slides.length) % slides.length;
					load(current);
					load((current + 1) % slides.length); // 预载下一张，避免切换闪白
					slides.forEach((img, k) => img.classList.toggle('is-active', k === current));
				}
				function start() {
					if (timerId !== null || reduceMotion.matches || document.visibilityState === 'hidden') return;
					timerId = window.setInterval(() => show(current + 1), INTERVAL);
				}
				function stop() {
					if (timerId === null) return;
					window.clearInterval(timerId);
					timerId = null;
				}

				show(0);
				start();
				header.addEventListener('mouseenter', stop);
				header.addEventListener('mouseleave', start);
				document.addEventListener('visibilitychange', () => {
					if (document.visibilityState === 'hidden') stop(); else start();
				});
				if (typeof reduceMotion.addEventListener === 'function') {
					reduceMotion.addEventListener('change', () => (reduceMotion.matches ? stop() : start()));
				}
			})();
		</script>
	</body>
</html>

<style>
	/* 100vw 出血：抵消 main 的 1200px 上限与左右 padding，横向铺满整个浏览器宽度 */
	.page-header {
		position: relative;
		width: 100vw;
		margin: 0 0 1rem;
		margin-left: calc(50% - 50vw);
		padding: 5rem 1.5rem 3rem;
		overflow: hidden;
	}
	/* 轮播容器：图片按 cover 铺满，高度随 banner 内容自适应 */
	.banner-carousel {
		position: absolute;
		inset: 0;
		z-index: 0;
		overflow: hidden;
		background: var(--primary-dark);
		pointer-events: none;
	}
	.banner-slide {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		max-width: none;
		margin: 0;
		border-radius: 0;
		box-shadow: none;
		object-fit: cover;
		object-position: center;
		opacity: 0;
		transition: opacity 1.1s ease;
	}
	.banner-slide.is-active { opacity: 1; }
	/* 默认 50% 虚化：模糊层以 50% 不透明度与清晰原图混合；鼠标移入或键盘聚焦时恢复清晰 */
	.banner-carousel::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		opacity: 0.5;
		transition: opacity 0.6s ease;
		pointer-events: none;
	}
	.page-header:hover .banner-carousel::after,
	.page-header:focus-within .banner-carousel::after { opacity: 0; }
	/* 不支持 backdrop-filter 的浏览器：降级为图片自身半强度模糊 */
	@supports not ((backdrop-filter: blur(4px)) or (-webkit-backdrop-filter: blur(4px))) {
		.banner-carousel::after { display: none; }
		.banner-slide { filter: blur(6px); transition: opacity 1.1s ease, filter 0.6s ease; }
		.page-header:hover .banner-slide,
		.page-header:focus-within .banner-slide { filter: none; }
	}
	/* 深色中性遮罩：保证白色标题在照片上的对比度，同时不篡改照片色彩 */
	.header-background {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(2, 6, 23, 0.40) 0%, rgba(2, 6, 23, 0.60) 100%);
		z-index: 0;
		pointer-events: none;
	}
	@media (max-width: 768px) {
		.page-header { padding-left: 1rem; padding-right: 1rem; }
	}
	@media (hover: none) {
		.page-header:active .banner-carousel::after { opacity: 0; }
	}
	@media (prefers-reduced-motion: reduce) {
		.banner-slide, .banner-carousel::after { transition: none; }
	}
	.header-content {
		max-width: 800px;
		margin: 0 auto;
		position: relative;
		z-index: 1;
		text-align: center;
	}
	.breadcrumb {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1.5rem;
		font-size: 0.875rem;
		padding: 0.5rem 1rem;
		background: linear-gradient(135deg, rgba(255, 255, 255, 0.25) 0%, rgba(255, 255, 255, 0.35) 100%);
		border-radius: 50px;
		border: 1px solid rgba(255, 255, 255, 0.5);
		backdrop-filter: blur(10px);
	}
	.breadcrumb a { color: rgba(255,255,255,0.8); text-decoration: none; transition: color 0.2s; }
	.breadcrumb a:hover { color: white; }
	.breadcrumb .separator { color: rgba(255,255,255,0.5); }
	.breadcrumb span:last-child { color: white; font-weight: 500; }
	.section-tag {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 1rem;
		background: linear-gradient(135deg, rgba(245, 158, 11, 0.1) 0%, rgba(245, 158, 11, 0.2) 100%);
		color: var(--accent-light);
		border-radius: 50px;
		font-size: 0.875rem;
		font-weight: 500;
		margin-bottom: 1rem;
		border: 1px solid rgba(245, 158, 11, 0.3);
	}
	.section-tag i { color: var(--accent); }
	.page-header h1 {
		color: var(--white);
		font-size: 2.5rem;
		margin: 0 0 0.5rem 0;
		font-family: 'Noto Sans SC', sans-serif;
		text-shadow: 0 3px 12px rgba(0, 0, 0, 0.4), 0 2px 6px rgba(0, 0, 0, 0.3);
	}
	@media (max-width: 768px) {
		.page-header h1 { font-size: 2rem; }
	}
	.subtitle {
		color: rgba(255, 255, 255, 1);
		margin: 0;
		font-size: 1rem;
		text-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
	}
	.category-filter { padding: 0 0 2rem; }
	.filter-container { max-width: 1200px; margin: 0 auto; display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; }
	.filter-btn {
		display: inline-flex; align-items: center; gap: 0.5rem;
		padding: 0.75rem 1.5rem; background: var(--white); border: 2px solid rgb(var(--gray-light));
		border-radius: 50px; color: rgb(var(--gray)); font-size: 0.9rem; font-weight: 500; cursor: pointer; transition: all 0.2s ease;
	}
	.filter-btn:hover { border-color: var(--accent); color: var(--accent); transform: translateY(-2px); box-shadow: var(--shadow-md); }
	.filter-btn.active { background: linear-gradient(135deg, var(--accent) 0%, var(--accent-light) 100%); border-color: var(--accent); color: var(--white); }
	.filter-btn i { font-size: 1rem; }
	.filter-btn .count { background: rgba(0,0,0,0.1); padding: 0.125rem 0.5rem; border-radius: 12px; font-size: 0.75rem; }
	.filter-btn.active .count { background: rgba(255,255,255,0.2); }
	@media (max-width: 640px) {
		.filter-container { gap: 0.5rem; }
		.filter-btn { padding: 0.5rem 1rem; font-size: 0.8rem; }
		.filter-btn span:not(.count) { display: none; }
	}

	/* 文章卡片：与首页 featured-section 的 post-card 保持同一套视觉 */
	.posts-section { padding: 1rem 0 4rem; }
	.posts-grid {
		max-width: 1200px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
		gap: 1.5rem;
	}
	@media (max-width: 640px) {
		.posts-grid { grid-template-columns: 1fr; }
	}
	.post-card {
		background: linear-gradient(135deg, var(--wave-gray) 0%, var(--primary-light) 100%);
		border-radius: 16px;
		box-shadow: var(--shadow-md);
		overflow: hidden;
		transition: all 0.3s ease;
		opacity: 0;
		animation: fadeInUp 0.6s ease forwards;
		animation-delay: var(--delay, 0s);
		border: 1px solid rgba(245, 158, 11, 0.1);
	}
	@keyframes fadeInUp {
		from { opacity: 0; transform: translateY(20px); }
		to { opacity: 1; transform: translateY(0); }
	}
	.post-card:hover {
		box-shadow: var(--shadow-xl), 0 0 30px rgba(245, 158, 11, 0.2);
		transform: translateY(-4px);
		border-color: rgba(245, 158, 11, 0.3);
	}
	.post-link { display: block; text-decoration: none; color: inherit; padding: 1.5rem; height: 100%; }
	.post-content { display: flex; flex-direction: column; height: 100%; }
	.post-meta { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem; flex-wrap: wrap; }
	.post-date { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; color: rgb(var(--gray)); }
	.post-date i { color: var(--accent); }
	.post-category-tag {
		display: inline-flex; align-items: center; gap: 0.35rem;
		margin-left: auto;
		padding: 0.2rem 0.65rem;
		background: rgba(245,158,11,0.1);
		color: var(--accent-light);
		border-radius: 20px;
		font-size: 0.7rem;
		font-weight: 500;
		border: 1px solid rgba(245,158,11,0.2);
		white-space: nowrap;
	}
	.post-category-tag i { font-size: 0.65rem; color: var(--accent); }
	.post-title {
		font-size: 1.125rem;
		font-weight: 600;
		color: var(--accent-light);
		margin: 0 0 0.75rem 0;
		line-height: 1.4;
		transition: all 0.2s;
	}
	.post-card:hover .post-title { color: var(--accent); text-shadow: 0 0 10px rgba(245, 158, 11, 0.5); }
	.post-excerpt { font-size: 0.9rem; color: rgb(var(--gray)); margin: 0 0 1rem 0; line-height: 1.6; flex-grow: 1; }
	.post-footer { margin-top: auto; }
	.read-more { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; font-weight: 500; color: var(--accent-light); transition: all 0.2s; }
	.post-card:hover .read-more { gap: 0.75rem; color: var(--accent); text-shadow: 0 0 10px rgba(245, 158, 11, 0.5); }
	@media (max-width: 640px) {
		.page-header h1 { font-size: 1.875rem; }
		.post-link { padding: 1.25rem; }
		.post-title { font-size: 1rem; }
	}
</style>

<!-- 分页按钮由客户端脚本生成，需用全局样式才能命中 -->
<style is:global>
	html { overflow-x: clip; }
	.blog-pagination { display: flex; justify-content: center; align-items: center; gap: 0.5rem; padding: 2.5rem 0 1rem; flex-wrap: wrap; }
	.blog-pagination .page-btn {
		min-width: 40px; height: 40px;
		display: inline-flex; align-items: center; justify-content: center;
		padding: 0 0.75rem;
		background: var(--white); border: 2px solid rgb(var(--gray-light)); border-radius: 8px;
		color: rgb(var(--gray)); font-size: 0.9rem; font-weight: 500; cursor: pointer; transition: all 0.2s ease;
	}
	.blog-pagination .page-btn:hover:not(.disabled) { border-color: var(--accent); color: var(--accent); transform: translateY(-2px); box-shadow: var(--shadow-sm); }
	.blog-pagination .page-btn.active { background: linear-gradient(135deg, var(--accent) 0%, var(--accent-light) 100%); border-color: var(--accent); color: var(--white); }
	.blog-pagination .page-btn.disabled { opacity: 0.4; cursor: not-allowed; }
	.blog-pagination .page-ellipsis { color: rgb(var(--gray)); padding: 0 0.25rem; }
	.blog-page-info { text-align: center; padding: 0.5rem 0 2rem; font-size: 0.85rem; color: rgb(var(--gray)); }
