---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featuredPosts = posts.slice(0, 6);
const totalPosts = posts.length;

// 首页 hero 轮播底图：用户提供的图床图片（按提供顺序循环）
const BANNER_IMAGES = [
	{ src: 'https://pic.homesh.top/file/AgACAgUAAyEGAATfDUfbAAMjavb4BnbXm6koutLmNGQq8EBVnigAAvgbaxt-BrhX--fUvdTj1TwBAAMCAAN3AAM9BA.jpg', width: 1920, height: 894 },
	{ src: 'https://pic.homesh.top/file/AgACAgUAAyEGAATfDUfbAAMkavb4BptVpFQNg00uGX1yS7_K8_QAAvkbaxt-BrhXSKR6llrMgBwBAAMCAAN3AAM9BA.jpg', width: 1920, height: 768 },
	{ src: 'https://pic.homesh.top/file/AgACAgUAAyEGAATfDUfbAAMlavb4BgojPGO-HW-LHM8DCCIzVucAAvobaxt-BrhXtJbLrUycTbcBAAMCAAN3AAM9BA.jpg', width: 1920, height: 792 },
	{ src: 'https://pic.homesh.top/file/AgACAgUAAyEGAATfDUfbAAMmavb4CB0ZnQLgh113iUM7BDzGXS8AAvsbaxt-BrhXzfyio1Vk3QABAQADAgADdwADPQQ.jpg', width: 1920, height: 700 },
	{ src: 'https://pic.homesh.top/file/AgACAgUAAyEGAATfDUfbAAMnavb4CEecocLRGjmmtv_zTBRGoO8AAvwbaxt-BrhXtGmBJLT8DKEBAAMCAAN3AAM9BA.jpg', width: 1920, height: 666 },
	{ src: 'https://pic.homesh.top/file/AgACAgUAAyEGAATfDUfbAAMoavb4DAOB1VrtsJUlvxjhC3lzMwAD_RtrG34GuFc5ZQsCpXfAIAEAAwIAA3cAAz0E.jpg', width: 1920, height: 700 },
	{ src: 'https://pic.homesh.top/file/AgACAgUAAyEGAATfDUfbAAMpavb4DCmz9RunUN7Rs3BVwcRyxRsAAv4baxt-BrhXAlckiZcqNjUBAAMCAAN3AAM9BA.jpg', width: 1664, height: 936 },
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<link rel="preconnect" href="https://pic.homesh.top" />
		<link rel="preload" as="image" href={BANNER_IMAGES[0].src} />
		<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet" />
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
	</head>
	<body>
		<Header />
		
		<main>
			<!-- Hero Section -->
			<section class="hero">
				<div class="hero-carousel" aria-hidden="true">
					{BANNER_IMAGES.map((img, i) => (
						<img
							class:list={['hero-slide', { 'is-active': i === 0 }]}
							src={i === 0 ? img.src : undefined}
							data-src={i === 0 ? undefined : img.src}
							width={img.width}
							height={img.height}
							alt=""
							loading={i === 0 ? 'eager' : 'lazy'}
							decoding="async"
						/>
					))}
				</div>
				<div class="hero-overlay" aria-hidden="true"></div>
				<div class="hero-content">
					<div class="hero-badge">
						<i class="fas fa-anchor"></i>
						<span>探索海洋的无限可能</span>
					</div>
					<h1 class="hero-title">
						欢迎来到<br />
						<span class="highlight">老鹏友的航海日志</span>
					</h1>
					<p class="hero-description">
						这里记录着我的航海梦想、游艇探索之旅，以及对海洋生活的热爱与思考。
						<br />
						愿与志同道合的朋友一起分享这片蔚蓝。
					</p>
					<div class="hero-stats">
						<div class="stat">
							<span class="stat-number">{totalPosts}</span>
							<span class="stat-label">篇文章</span>
						</div>
						<div class="stat-divider"></div>
						<div class="stat">
							<span class="stat-number">∞</span>
							<span class="stat-label">探索精神</span>
						</div>
						<div class="stat-divider"></div>
						<div class="stat">
							<span class="stat-number">🌊</span>
							<span class="stat-label">海洋梦想</span>
						</div>
					</div>
					<div class="hero-actions">
						<a href="/blog" class="btn btn-primary">
							<i class="fas fa-compass"></i>
							开始探索
						</a>
						<a href="/about" class="btn btn-secondary">
							<i class="fas fa-user"></i>
							了解更多
						</a>
					</div>
				</div>
				<div class="hero-visual">
					<div class="wave-decoration">
						<svg viewBox="0 0 1440 320" class="wave">
							<path fill="#1a365d" fill-opacity="0.1" d="M0,96L48,112C96,128,192,160,288,160C384,160,480,128,576,112C672,96,768,96,864,112C960,128,1056,160,1152,160C1248,160,1344,128,1392,112L1440,96L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path>
						</svg>
					</div>
				</div>
			</section>
			
			<!-- Featured Posts Section -->
			<section class="featured-section">
				<div class="section-header">
					<div class="section-tag">
						<i class="fas fa-star"></i>
						<span>最新文章</span>
					</div>
					<h2>探索精彩内容</h2>
				</div>
				
				<div class="posts-grid">
					{
						featuredPosts.map((post, index) => (
							<article class="post-card" style={`--delay: ${index * 0.1}s`}>
								<a href={`/blog/${post.id}/`} class="post-link">
									<div class="post-content">
										<div class="post-meta">
											<span class="post-date">
												<i class="far fa-calendar"></i>
												<FormattedDate date={post.data.pubDate} />
											</span>
										</div>
										<h3 class="post-title">{post.data.title}</h3>
										<p class="post-excerpt">
											{post.data.description?.slice(0, 80) || '点击阅读更多...'}
											{post.data.description?.length > 80 ? '...' : ''}
										</p>
										<div class="post-footer">
											<span class="read-more">
												阅读全文 <i class="fas fa-arrow-right"></i>
											</span>
										</div>
									</div>
								</a>
							</article>
						))
					}
				</div>
				
				<div class="section-footer">
					<a href="/blog" class="btn btn-primary">
						查看全部文章 <i class="fas fa-arrow-right"></i>
					</a>
				</div>
			</section>
		</main>
		
		<Footer />

		<script>
			// 首页 hero 轮播：按需加载、hover 暂停、后台标签页暂停、尊重减少动效偏好
			(() => {
				const hero = document.querySelector('.hero');
				const carousel = document.querySelector('.hero-carousel');
				if (!hero || !carousel) return;
				const slides = Array.from(carousel.querySelectorAll('.hero-slide'));
				if (slides.length < 2) return;

				const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
				const INTERVAL = 5000;
				let current = 0;
				let timerId = null;

				function load(i) {
					const img = slides[i];
					if (img && img.dataset.src) {
						img.src = img.dataset.src;
						delete img.dataset.src;
					}
				}
				function show(i) {
					current = (i + slides.length) % slides.length;
					load(current);
					load((current + 1) % slides.length);
					slides.forEach((img, k) => img.classList.toggle('is-active', k === current));
				}
				function start() {
					if (timerId !== null || reduceMotion.matches || document.visibilityState === 'hidden') return;
					timerId = window.setInterval(() => show(current + 1), INTERVAL);
				}
				function stop() {
					if (timerId === null) return;
					window.clearInterval(timerId);
					timerId = null;
				}

				show(0);
				start();
				hero.addEventListener('mouseenter', stop);
				hero.addEventListener('mouseleave', start);
				document.addEventListener('visibilitychange', () => {
					if (document.visibilityState === 'hidden') stop(); else start();
				});
				if (typeof reduceMotion.addEventListener === 'function') {
					reduceMotion.addEventListener('change', () => (reduceMotion.matches ? stop() : start()));
				}
			})();
		</script>
	</body>
</html>

<style>
	/* Hero Section */
	/* 全宽出血：抵消 main 的 1200px 上限，底图横向铺满浏览器宽度 */
	.hero {
		position: relative;
		width: 100vw;
		margin-left: calc(50% - 50vw);
		padding: 4rem 1.5rem 6rem;
		background: var(--primary-dark);
		overflow: hidden;
	}
	/* 轮播底图：cover 铺满 hero 区域，高度随内容自适应 */
	.hero-carousel {
		position: absolute;
		inset: 0;
		z-index: 0;
		background: var(--primary-dark);
		overflow: hidden;
		pointer-events: none;
	}
	.hero-slide {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		max-width: none;
		margin: 0;
		border-radius: 0;
		box-shadow: none;
		object-fit: cover;
		object-position: center;
		opacity: 0;
		transition: opacity 1.1s ease;
	}
	.hero-slide.is-active { opacity: 1; }
	/* 默认 50% 虚化：模糊层半透明叠加在清晰原图上；鼠标移入或键盘聚焦时清晰 */
	.hero-carousel::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		opacity: 0.5;
		transition: opacity 0.6s ease;
		pointer-events: none;
	}
	.hero:hover .hero-carousel::after,
	.hero:focus-within .hero-carousel::after { opacity: 0; }
	/* 浏览器不支持 backdrop-filter 时，降级为图片自身半强度模糊 */
	@supports not ((backdrop-filter: blur(4px)) or (-webkit-backdrop-filter: blur(4px))) {
		.hero-carousel::after { display: none; }
		.hero-slide { filter: blur(6px); transition: opacity 1.1s ease, filter 0.6s ease; }
		.hero:hover .hero-slide,
		.hero:focus-within .hero-slide { filter: none; }
	}
	/* 深色中性遮罩：保证标题与正文在照片上的对比度 */
	.hero-overlay {
		position: absolute;
		inset: 0;
		z-index: 1;
		background: linear-gradient(180deg, rgba(2, 6, 23, 0.45) 0%, rgba(2, 6, 23, 0.68) 100%);
		pointer-events: none;
	}
	@media (max-width: 768px) {
		.hero { padding-left: 1rem; padding-right: 1rem; }
	}
	@media (hover: none) {
		.hero:active .hero-carousel::after { opacity: 0; }
	}
	@media (prefers-reduced-motion: reduce) {
		.hero-slide, .hero-carousel::after { transition: none; }
	}
	
	.hero-content {
		position: relative;
		z-index: 2;
		text-align: center;
		max-width: 800px;
		margin: 0 auto;
	}
	
	.hero-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 1rem;
		background: linear-gradient(135deg, rgba(245, 158, 11, 0.1) 0%, rgba(245, 158, 11, 0.2) 100%);
		color: var(--accent-light);
		border-radius: 50px;
		font-size: 0.875rem;
		font-weight: 500;
		margin-bottom: 1.5rem;
		border: 1px solid rgba(245, 158, 11, 0.3);
		box-shadow: 0 0 20px rgba(245, 158, 11, 0.2);
	}
	
	.hero-badge i {
		color: var(--accent);
		animation: pulse 2s ease-in-out infinite;
	}
	
	@keyframes pulse {
		0%, 100% { opacity: 1; }
		50% { opacity: 0.6; }
	}
	
	.hero-title {
		font-size: 3rem;
		font-weight: 700;
		margin-bottom: 1rem;
		line-height: 1.2;
		font-family: 'Noto Sans SC', sans-serif;
		color: var(--white);
		text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
	}
	
	.hero-title .highlight {
		background: linear-gradient(135deg, var(--accent) 0%, var(--accent-light) 50%, #fcd34d 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		font-family: 'Playfair Display', serif;
		text-shadow: none;
	}
	
	@media (max-width: 768px) {
		.hero-title {
			font-size: 2rem;
		}
	}
	
	.hero-description {
		font-size: 1.125rem;
		color: rgb(var(--gray));
		max-width: 600px;
		margin: 0 auto 2rem;
		line-height: 1.8;
	}
	
	.hero-stats {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 2rem;
		margin-bottom: 2rem;
	}
	
	@media (max-width: 640px) {
		.hero-stats {
			gap: 1rem;
		}
	}
	
	.stat {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
	}
	
	.stat-number {
		font-size: 1.75rem;
		font-weight: 700;
		background: linear-gradient(135deg, var(--accent) 0%, var(--accent-light) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}
	
	.stat-label {
		font-size: 0.875rem;
		color: rgb(var(--gray));
	}
	
	.stat-divider {
		width: 1px;
		height: 40px;
		background: linear-gradient(180deg, transparent 0%, var(--accent) 50%, transparent 100%);
	}
	
	.hero-actions {
		display: flex;
		justify-content: center;
		gap: 1rem;
		flex-wrap: wrap;
	}
	
	.hero-visual {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		z-index: 1;
	}
	
	.wave-decoration {
		position: absolute;
		bottom: -1px;
		left: 0;
		right: 0;
	}
	
	.wave {
		display: block;
		width: 100%;
		height: auto;
	}
	
	/* Featured Section */
	.featured-section {
		padding: 3rem 0 4rem;
	}
	
	.section-header {
		text-align: center;
		margin-bottom: 3rem;
	}
	
	.section-tag {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 1rem;
		background: linear-gradient(135deg, rgba(245, 158, 11, 0.1) 0%, rgba(245, 158, 11, 0.2) 100%);
		color: var(--accent-light);
		border-radius: 50px;
		font-size: 0.875rem;
		font-weight: 500;
		margin-bottom: 1rem;
		border: 1px solid rgba(245, 158, 11, 0.3);
	}
	
	.section-tag i {
		color: var(--accent);
	}
	
	.section-header h2 {
		font-size: 2rem;
		color: var(--accent);
		margin: 0;
		text-shadow: 0 0 20px rgba(245, 158, 11, 0.3);
	}
	
	/* Posts Grid */
	.posts-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
		gap: 1.5rem;
		margin-bottom: 3rem;
	}
	
	@media (max-width: 640px) {
		.posts-grid {
			grid-template-columns: 1fr;
		}
	}
	
	.post-card {
		background: linear-gradient(135deg, var(--wave-gray) 0%, var(--primary-light) 100%);
		border-radius: 16px;
		box-shadow: var(--shadow-md);
		overflow: hidden;
		transition: all 0.3s ease;
		opacity: 0;
		animation: fadeInUp 0.6s ease forwards;
		animation-delay: var(--delay, 0s);
		border: 1px solid rgba(245, 158, 11, 0.1);
	}
	
	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
	
	.post-card:hover {
		box-shadow: var(--shadow-xl), 0 0 30px rgba(245, 158, 11, 0.2);
		transform: translateY(-4px);
		border-color: rgba(245, 158, 11, 0.3);
	}
	
	.post-link {
		display: block;
		text-decoration: none;
		color: inherit;
		padding: 1.5rem;
		height: 100%;
	}
	
	.post-content {
		display: flex;
		flex-direction: column;
		height: 100%;
	}
	
	.post-meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.75rem;
	}
	
	.post-date {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.8rem;
		color: rgb(var(--gray));
	}
	
	.post-date i {
		color: var(--accent);
	}
	
	.post-title {
		font-size: 1.125rem;
		font-weight: 600;
		color: var(--accent-light);
		margin: 0 0 0.75rem 0;
		line-height: 1.4;
		transition: all 0.2s;
	}
	
	.post-card:hover .post-title {
		color: var(--accent);
		text-shadow: 0 0 10px rgba(245, 158, 11, 0.5);
	}
	
	.post-excerpt {
		font-size: 0.9rem;
		color: rgb(var(--gray));
		margin: 0 0 1rem 0;
		line-height: 1.6;
		flex-grow: 1;
	}
	
	.post-footer {
		margin-top: auto;
	}
	
	.read-more {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--accent-light);
		transition: all 0.2s;
	}
	
	.post-card:hover .read-more {
		gap: 0.75rem;
		color: var(--accent);
		text-shadow: 0 0 10px rgba(245, 158, 11, 0.5);
	}
	
	.section-footer {
		text-align: center;
	}
</style>

<!-- 全宽 hero 需要全局规则，避免滚动条宽度导致横向溢出 -->
<style is:global>
	html { overflow-x: clip; }
</style>
